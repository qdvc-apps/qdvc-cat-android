<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.QdvcCat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QdvcCat">

            <!-- Launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for any text/* content (covers .txt, .md, .csv,
                 .json, .css, .sql, .py and friends when the file browser
                 supplies a text MIME type). -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- Some structured formats are advertised under application/*
                 MIME types by file browsers, so claim those explicitly. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-sql" />
                <data android:mimeType="application/x-python" />
                <data android:mimeType="text/x-python" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Fallback: match by file extension for browsers that hand over
                 an octet-stream / unknown MIME but a real path or filename.
                 The host wildcard + pathPattern set is the standard Android
                 idiom for extension matching over content:// and file:// URIs. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.text" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\.tsv" />
                <data android:pathPattern=".*\\.sql" />
                <data android:pathPattern=".*\\.py" />
                <data android:pathPattern=".*\\.css" />
            </intent-filter>
        </activity>
    </application>
</manifest>
